# --- LLM (summarization) ---
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# --- ASR (transcription) ---
# "local" uses faster-whisper running on this machine (no external API, free, works offline).
# "openai" uses the OpenAI Whisper API instead (set OPENAI_API_KEY below).
ASR_PROVIDER=local

# Only needed if ASR_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# faster-whisper model size when ASR_PROVIDER=local
# options: tiny, base, small, medium, large-v3 (bigger = more accurate, slower)
WHISPER_MODEL_SIZE=small

# --- App ---
DATABASE_PATH=./data/meetings.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=200
